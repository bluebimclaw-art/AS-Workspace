# Copy to .env; npm start loads .env, not this example file.
# Cloud base includes /v1; no user files are transmitted until Run is pressed.
POC_CLOUD_BASE_URL=https://approved-provider.example/v1
POC_CLOUD_MODEL=
POC_CLOUD_API_KEY=
POC_LOCAL_BASE_URL=http://127.0.0.1:11434
POC_LOCAL_MODEL=
POC_LOCAL_API_KEY=
POC_HERMES_API_KEY=
# Optional Windows-local read-only Revit MCP connector. Server-side configuration only.
# Absolute path to an existing MCP-Server/build/index.js; does not install an add-in.
POC_REVIT_MCP_ENTRY=
POC_REVIT_MCP_PORT=8964
POC_REVIT_EXPECTED_YEAR=2024
POC_REVIT_EXPECTED_MCP_VERSION=1.0.0
# Folder search: local OCR models copied by npm run search:ocr:setup.
POC_OCR_LANG_DIR=tools/ocr
# Optional absolute paths; blank means platform-managed Java / PATH pdftoppm.
POC_JAVA_BIN=
POC_PDFTOPPM_BIN=
